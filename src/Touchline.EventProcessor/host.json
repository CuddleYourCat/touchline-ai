{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "extensions": {
    "eventHubs": {
      "maxEventBatchSize": 100,
      "batchCheckpointFrequency": 1
    },
    "serviceBus": {
      "maxConcurrentCalls": 4,
      "prefetchCount": 0,
      "maxAutoLockRenewalDuration": "00:10:00"
    }
  },
  "logging": {
    "logLevel": {
      "default": "Information",
      "Host.Results": "Information",
      "Function": "Warning"
    }
  }
}
