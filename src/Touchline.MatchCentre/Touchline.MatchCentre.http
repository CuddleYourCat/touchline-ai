@Touchline.MatchCentre_HostAddress = http://localhost:5054
@match = demo-1

GET {{Touchline.MatchCentre_HostAddress}}/api/status
Accept: application/json

###

GET {{Touchline.MatchCentre_HostAddress}}/openapi/v1.json

###

GET {{Touchline.MatchCentre_HostAddress}}/api/teams

###

GET {{Touchline.MatchCentre_HostAddress}}/api/teams/north-bank-fc

###

GET {{Touchline.MatchCentre_HostAddress}}/api/matches?status=live

###

GET {{Touchline.MatchCentre_HostAddress}}/api/matches/{{match}}

###

GET {{Touchline.MatchCentre_HostAddress}}/api/matches/{{match}}/events?after=0&limit=50

###

GET {{Touchline.MatchCentre_HostAddress}}/api/matches/{{match}}/momentum

###

GET {{Touchline.MatchCentre_HostAddress}}/api/matches/{{match}}/moments?mode=analyst&lang=en&team=north-bank-fc

###

# Server-sent events. Leave it open to watch the match; curl -N shows it best.
GET {{Touchline.MatchCentre_HostAddress}}/api/matches/{{match}}/stream
Accept: text/event-stream

###

POST {{Touchline.MatchCentre_HostAddress}}/api/matches/{{match}}/questions?mode=casual
Content-Type: application/json

{ "question": "Who has been the most dangerous player?" }

###

GET {{Touchline.MatchCentre_HostAddress}}/api/matches/{{match}}/recap
