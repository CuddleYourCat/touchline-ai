<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the versions below override transitive dependencies, so a vulnerable package can be pinned to a patched version. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire integrations: hosting (AppHost) and clients (services), kept on the AppHost SDK's version. -->
    <PackageVersion Include="Aspire.Hosting.Azure.CosmosDB" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Azure.EventHubs" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Azure.Functions" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.1" />
    <PackageVersion Include="Aspire.Azure.Messaging.EventHubs" Version="13.6.1" />
    <PackageVersion Include="Aspire.Azure.Messaging.ServiceBus" Version="13.6.1" />
    <PackageVersion Include="Aspire.Microsoft.Azure.Cosmos" Version="13.6.1" />
    <!-- The Event Processor: Functions isolated worker (ADR-015). -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.EventHubs" Version="6.5.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.CosmosDB" Version="4.16.1" />
    <!-- The live commentary trigger on the key-moments topic (ADR-030, ADR-045). -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.24.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.OpenTelemetry" Version="1.2.0" />
    <!-- Exports the service defaults' OpenTelemetry to Application Insights in Azure (ADR-024). -->
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
    <!-- The agent squad (ADR-006, ADR-042, ADR-043): Agent Framework, Microsoft.Extensions.AI and the GA OpenAI SDK, with an Entra ID token. -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.25.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.25.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- The Match Centre's OpenAPI document (ADR-027), on the same version as the ASP.NET Core packages. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
  <!-- Transitive pins for packages with known vulnerabilities (NU1902/NU1903). Remove each once the package that pulls it in ships a fixed version. -->
  <ItemGroup>
    <!-- Aspire.Hosting 13.6.1 -> StreamJsonRpc 2.25.29 -> MessagePack 2.5.302 (GHSA-qhrr-8q5h-9q3h). 2.5.307 is the latest 2.x patch. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
  </ItemGroup>
</Project>
